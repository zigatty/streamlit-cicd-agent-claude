# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required for cicd_agent.py (Claude-powered auto-fix agent)
ANTHROPIC_API_KEY=sk-ant-...

# Required for real GCP deployments via bitbucket-pipelines.yml
# Base64-encode your GCP service account JSON key:
#   Linux:  base64 -w 0 sa-key.json
#   macOS:  base64 -i sa-key.json
GCLOUD_SERVICE_KEY=<base64-encoded-service-account-key>
